+    async Task CloseTransport()
+    {
+        var previous = transport;
+        transport = null;
+        device = null;
+        ClearRemoteViews();
+        ShowInfo();
+        if (previous != null)
+        {
+            try
+            {
+                await previous.DisposeAsync();
