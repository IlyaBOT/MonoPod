+    async Task<bool> Run(string text, Func<CancellationToken, Task> action)
+    {
+        if (busy)
+            return false;
+        bool succeeded = false;
+        busy = true;
+        operation = new();
+        status.Text = text;
+        SetState();
+        try
+        {
+            await action(operation.Token);
+            status.Text = "Ready";
+            succeeded = true;
+        }
+        catch (OperationCanceledException)
+        {
+            bool userCancelled = operation.IsCancellationRequested;
+            if (transport != null && (transport.IsUsb || !userCancelled))
+            {
+                await CloseTransport();
+            }
+
+            status.Text = userCancelled ? "Cancelled safely; reconnect USB if the binary transfer was interrupted." : "The connection timed out. Reconnect and check that Sync Mode is active.";
+            log.Write(status.Text);
+            if (!userCancelled && !smoke)
+                MessageBox.Show(this, status.Text, "Connection timeout", MessageBoxButtons.OK, MessageBoxIcon.Error);
+        }
+        catch (Exception e)
+        {
+            status.Text = e.Message;
+            log.Write(text + ": " + e.Message);
+            if (!smoke)
+                MessageBox.Show(this, e.Message, "MonoPod Desktop", MessageBoxButtons.OK, MessageBoxIcon.Error);
+            if (transport != null && (e is InvalidDataException or TimeoutException or HttpRequestException ||
+                e is IOException and not DeviceException ||
+                transport.IsUsb && e is DeviceException { Code: "SD_WRITE" or "TIMEOUT_OR_DISCONNECT" }))
+            {
+                await CloseTransport();
+            }
+        }
+        finally
+        {
+            operation.Dispose();
+            operation = null;
+            busy = false;
+            transferBar.Value = 0;
+            SetState();
+            if (closePending)
+                Close();
+        }
+        return succeeded;
+    }
